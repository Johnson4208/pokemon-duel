rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /learners/{uid} {
   function owner(){return request.auth != null && request.auth.uid == uid;}
   function valid(p){return p.keys().hasOnly(['nickname','avatar','language','uiLanguage','known','completed','stars','totalEarned','totalSpent','owned','vouchers','minutes','goal','practiceDays','streak']) && p.nickname is string && p.nickname.size()>0 && p.nickname.size()<=20 && p.avatar in ['fox','cat','dog','panda','koala','rabbit','bear','frog','owl','penguin','duck','lion','tiger','monkey','pig','mouse','raccoon','elephant','deer','sloth'] && p.language in ['vi','en','zh'] && p.uiLanguage in ['vi','en','zh'] && p.known is list && p.known.size()<=9000 && p.known.toSet().size()==p.known.size() && p.completed is list && p.completed.size()<=9000 && p.completed.toSet().size()==p.completed.size() && p.owned is list && p.owned.toSet().size()==p.owned.size() && p.owned.hasAll([25,133,3]) && p.owned.hasOnly([25, 133, 1, 4, 7, 39, 54, 52, 37, 722, 447, 3, 6, 9, 59, 197, 700, 94, 778, 131, 282, 658, 448, 143, 727, 149, 373, 445, 113, 36, 531, 242, 151, 150, 384, 383, 382, 386, 483, 484, 487, 493, 643, 644, 716, 717, 791, 792]) && (!p.keys().hasAny(['vouchers']) || (p.vouchers is list && p.vouchers.size()<=100)) && p.stars is int && p.stars>=0 && p.totalEarned is int && p.totalSpent is int && p.totalEarned==p.completed.size() && p.stars==p.totalEarned-p.totalSpent && p.minutes is int && p.minutes>=0 && p.goal in [5,10,15] && p.practiceDays is list && p.practiceDays.size()<=9000 && p.streak is int && p.streak>=1;}
   function price(id){return id==6?12 : id==9?12 : id==59?15 : id==197?18 : id==700?18 : id==94?23 : id==778?23 : id==131?27 : id==282?30 : id==658?33 : id==448?38 : id==143?42 : id==727?45 : id==149?53 : id==373?60 : id==445?68 : id==113?20 : id==36?24 : id==531?32 : id==242?48 : id==151?128 : id==150?180 : id==384?220 : id==383?175 : id==382?175 : id==386?145 : id==483?190 : id==484?190 : id==487?210 : id==493?260 : id==643?170 : id==644?170 : id==716?160 : id==717?160 : id==791?185 : id==792?185:1000000;}
   function settings(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nickname','avatar','goal','language','uiLanguage']);}
   function unlearn(){return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['known']) && resource.data.known.hasAll(request.resource.data.known);}
   function relearn(){let a=resource.data;let b=request.resource.data;return b.diff(a).affectedKeys().hasOnly(['known']) && b.known.hasAll(a.known) && b.known.size()==a.known.size()+1 && (a.completed.hasAny(['learn:'+b.known[b.known.size()-1]]) || a.completed.hasAny(['solve:'+b.known[b.known.size()-1]]) || a.completed.hasAny(['word:'+b.known[b.known.size()-1]]));}
   function reward(){let a=resource.data;let b=request.resource.data;let key=b.completed[b.completed.size()-1];return b.diff(a).affectedKeys().hasOnly(['known','completed','stars','totalEarned','minutes','practiceDays']) && b.completed.size()==a.completed.size()+1 && b.completed.hasAll(a.completed) && !(key in a.completed) && key.matches('^(learn|solve):(vi|en|zh):[a-z0-9-]+$') && key.size()<=180 && b.stars==a.stars+1 && b.totalEarned==a.totalEarned+1 && b.minutes==a.minutes+1 && b.known.hasAll(a.known) && b.known.size()<=a.known.size()+1 && b.practiceDays.hasAll(a.practiceDays) && b.practiceDays.size()<=a.practiceDays.size()+1;}
   function purchase(){let a=resource.data;let b=request.resource.data;return b.diff(a).affectedKeys().hasOnly(['owned','stars','totalSpent']) && b.owned.size()==a.owned.size()+1 && b.owned.hasAll(a.owned) && !(b.owned[b.owned.size()-1] in a.owned) && a.stars>=price(b.owned[b.owned.size()-1]) && b.totalSpent==a.totalSpent+a.stars && b.stars==0;}
   function vouchers(p){return p.keys().hasAny(['vouchers'])?p.vouchers:[];}
   function voucherPurchase(){let a=resource.data;let b=request.resource.data;let old=vouchers(a);let next=b.vouchers;let v=next[next.size()-1];return b.diff(a).affectedKeys().hasOnly(['vouchers','stars','totalSpent']) && old.size()<100 && next is list && next.size()==old.size()+1 && next.hasAll(old) && v is map && v.keys().hasOnly(['code','discount','issuedAt']) && v.keys().hasAll(['code','discount','issuedAt']) && v.discount in [10,15] && v.code is string && ((v.discount==10 && v.code.matches('^LL10-[A-Z0-9]{8}$') && a.stars>=1000) || (v.discount==15 && v.code.matches('^LL15-[A-Z0-9]{8}$') && a.stars>=1850)) && v.issuedAt is int && v.issuedAt>=0 && b.totalSpent==a.totalSpent+a.stars && b.stars==0;}
   allow read: if owner();
   allow create: if owner() && valid(request.resource.data) && request.resource.data.stars==0 && request.resource.data.totalEarned==0 && request.resource.data.totalSpent==0 && request.resource.data.owned==[25,133,3] && request.resource.data.known==[] && request.resource.data.minutes==0 && request.resource.data.practiceDays==[];
   allow update: if owner() && valid(request.resource.data) && (settings() || unlearn() || relearn() || reward() || purchase() || voucherPurchase());
   allow delete: if false;
  }
 }
}
